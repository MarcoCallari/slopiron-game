# Defensive play file.
#   formation: name from formations/defense.yaml
#   assign: per player id ->
#     rush                        pass rush / attack the run (default for DE and DT)
#     {man: "#1 left"}            man coverage on a receiver (see formations/defense.yaml for the labels)
#     {zone: [x, y]}              underneath zone; x = depth from the line, y = field position measured
#                                 from the offense's left sideline (0 .. 53.3, middle = 26.7)
#     {zone_rel: [x, y]}          zone relative to the ball (robber / hole player)
#     {deep: [x, y], band: w}     deep zone: stay on top of every vertical threat within +-w yards of y
#   Any assignment can override the alignment with at / over / depth / inside.
#   ai: hints for the CPU coordinator (weight, situation multipliers, man / blitz flags)
name: Cover 2 (Tampa)
formation: base_43
description: "Two deep halves, corners squat in the flats, middle linebacker carries the seam."
assign:
  LCB: {zone: [5, 7], depth: 5}
  RCB: {zone: [5, 46.3], depth: 5}
  WLB: {zone: [8, 16]}
  MLB: {zone: [13, 26.7]}
  SLB: {zone: [8, 37.3]}
  SS:  {deep: [18, 13.5], band: 16, at: [12, -10]}
  FS:  {deep: [18, 39.8], band: 16, at: [12, 10]}
ai: {weight: 0.8, long_yardage: 1.4}
name: Cover 3
formation: base_43
