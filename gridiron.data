␀␀‘␀␀␀␀␀␀␀␀␀␀␀’␀ﬁ␀␀␀␀␀␀␀␀␀6␀␀␀␀␀␀␀"␀(␀”␀␀G␀M␀“␀␀G␀J␀ﬂ␀␀G␀–␀␀M␀œ␀␀J␀␀␀G# Defensive formations.
#   pos: depth-chart group (DE, DT, LB, CB, S)
#   at:  [x, y] relative to the ball: x = yards off the ball, y = yards right (+) / left (-)
#   over: align on an offensive receiver instead of a fixed spot:
#         "#1 left" = widest receiver on the left, "#2 right" = second from the outside on the right,
#         "#2 strong" / "#2 weak" = side with more / fewer receivers, "back" / "back2" = backfield players
#   depth / inside: yards off the ball and yards inside of that receiver
# Plays can override any alignment.

base_43:
  title: 4-3 Base
  description: 4-3 base (4 DL, 3 LB, 2 CB, 2 S)
  personnel: "4-3"
  players:
    LE:  {pos: DE, at: [1, -3.8]}
    LDT: {pos: DT, at: [1, -1.1]}
    RDT: {pos: DT, at: [1, 1.1]}
    RE:  {pos: DE, at: [1, 3.8]}
    WLB: {pos: LB, at: [4.5, -3.5]}
    MLB: {pos: LB, at: [4.5, 0]}
    SLB: {pos: LB, at: [4.5, 3.5]}
    LCB: {pos: CB, over: "#1 left", depth: 6.5, inside: 0.9}
    RCB: {pos: CB, over: "#1 right", depth: 6.5, inside: 0.9}
    SS:  {pos: S, at: [10, -7]}
    FS:  {pos: S, at: [12, 7]}

nickel:
  title: Nickel
  description: Nickel 4-2-5 (4 DL, 2 LB, 3 CB, 2 S)
  personnel: "4-2-5"
  players:
    LE:  {pos: DE, at: [1, -3.8]}
    LDT: {pos: DT, at: [1, -1.1]}
    RDT: {pos: DT, at: [1, 1.1]}
    RE:  {pos: DE, at: [1, 3.8]}
    WLB: {pos: LB, at: [4.5, -2]}
    MLB: {pos: LB, at: [4.5, 2]}
    LCB: {pos: CB, over: "#1 left", depth: 6.5, inside: 0.9}
    RCB: {pos: CB, over: "#1 right", depth: 6.5, inside: 0.9}
    NCB: {pos: CB, over: "#2 strong", depth: 5, inside: 0.7}
    SS:  {pos: S, at: [10, -7]}
    FS:  {pos: S, at: [12, 7]}

base_34:
  title: 3-4 Base
  description: 3-4 base (3 DL, 2 outside and 2 inside linebackers, 2 CB, 2 S). The outside
    linebackers come from the DE group (the edge rushers), the down linemen from DT.
  personnel: "3-4"
  players:
    LE:   {pos: DT, at: [1, -2.6]}
    NT:   {pos: DT, at: [1, 0]}
    RE:   {pos: DT, at: [1, 2.6]}
    LOLB: {pos: DE, at: [1.2, -5]}
    ROLB: {pos: DE, at: [1.2, 5]}
    LILB: {pos: LB, at: [4.5, -2]}
    RILB: {pos: LB, at: [4.5, 2]}
    LCB:  {pos: CB, over: "#1 left", depth: 6.5, inside: 0.9}
    RCB:  {pos: CB, over: "#1 right", depth: 6.5, inside: 0.9}
    SS:   {pos: S, at: [10, -7]}
    FS:   {pos: S, at: [12, 7]}

dime:
  title: Dime
  description: Dime 4-1-6 (4 DL, 1 LB, 4 CB, 2 S) for obvious passing downs
  personnel: "4-1-6"
  players:
    LE:  {pos: DE, at: [1, -3.8]}
    LDT: {pos: DT, at: [1, -1.1]}
    RDT: {pos: DT, at: [1, 1.1]}
    RE:  {pos: DE, at: [1, 3.8]}
    MLB: {pos: LB, at: [5, 0]}
    LCB: {pos: CB, over: "#1 left", depth: 7, inside: 0.9}
    RCB: {pos: CB, over: "#1 right", depth: 7, inside: 0.9}
    NCB: {pos: CB, over: "#2 strong", depth: 5.5, inside: 0.7}
    DCB: {pos: CB, over: "#2 weak", depth: 5.5, inside: 0.7}
    SS:  {pos: S, at: [12, -8]}
    FS:  {pos: S, at: [14, 8]}

goal_line_44:
  title: Goal Line
  description: Goal-line 4-4 (4 DL, 4 LB, 2 CB, 1 S), everybody in the box
  personnel: "4-4"
  players:
    LE:  {pos: DE, at: [0.8, -3.8]}
    LDT: {pos: DT, at: [0.8, -1.1]}
    RDT: {pos: DT, at: [0.8, 1.1]}
    RE:  {pos: DE, at: [0.8, 3.8]}
    WLB: {pos: LB, at: [3, -5]}
    MLB: {pos: LB, at: [3, -1.5]}
    SLB: {pos: LB, at: [3, 1.5]}
    JLB: {pos: LB, at: [3, 5]}
    LCB: {pos: CB, over: "#1 left", depth: 3, inside: 0.5}
    RCB: {pos: CB, over: "#1 right", depth: 3, inside: 0.5}
    FS:  {pos: S, at: [7, 0]}

stack_335:
  title: 3-3-5
  description: 3-3-5 stack (3 DL, 3 LB, 3 CB, 2 S), linebackers stacked behind the line, five defensive backs
  personnel: "3-3-5"
  players:
    LE:  {pos: DE, at: [1, -3.4]}
    NT:  {pos: DT, at: [1, 0]}
    RE:  {pos: DE, at: [1, 3.4]}
    WLB: {pos: LB, at: [4.5, -3.4]}
    MLB: {pos: LB, at: [4.5, 0]}
    SLB: {pos: LB, at: [4.5, 3.4]}
    LCB: {pos: CB, over: "#1 left", depth: 6.5, inside: 0.9}
    RCB: {pos: CB, over: "#1 right", depth: 6.5, inside: 0.9}
    NCB: {pos: CB, over: "#2 strong", depth: 5, inside: 0.7}
    SS:  {pos: S, at: [10, -7]}
    FS:  {pos: S, at: [12, 7]}

big_nickel:
  title: Nickel
  description: Big nickel 4-2-5 with a third safety instead of the nickel corner (better against the run)
  personnel: "4-2-5"
  players:
    LE:  {pos: DE, at: [1, -3.8]}
    LDT: {pos: DT, at: [1, -1.1]}
    RDT: {pos: DT, at: [1, 1.1]}
    RE:  {pos: DE, at: [1, 3.8]}
    WLB: {pos: LB, at: [4.5, -2]}
    MLB: {pos: LB, at: [4.5, 2]}
    LCB: {pos: CB, over: "#1 left", depth: 6.5, inside: 0.9}
    RCB: {pos: CB, over: "#1 right", depth: 6.5, inside: 0.9}
    SS:  {pos: S, at: [10, -7]}
    FS:  {pos: S, at: [12, 7]}
    BS:  {pos: S, over: "#2 strong", depth: 6, inside: 0.5}
# Offensive formations.
#   pos: depth-chart group that fills the spot (QB, RB, FB, WR, TE, OL)
#   at:  [x, y] relative to the ball: x = yards from the line of scrimmage (negative = backfield),
#        y = yards right (+) / left (-) of the ball
# Spots with the same pos are filled in the order listed (first WR = WR1 on the depth chart).
# OL is always listed LT, LG, C, RG, RT.
# title: name shown in the play-calling menu (plays are grouped by it).

gun_11:
  title: Shotgun
  description: Shotgun, 11 personnel (1 RB, 1 TE, 3 WR)
  personnel: "11"
  players:
    QB: {pos: QB, at: [-5, 0]}
    RB: {pos: RB, at: [-5, 1.6]}
    X:  {pos: WR, at: [-1, -19]}
    Z:  {pos: WR, at: [-1.5, 18]}
    H:  {pos: WR, at: [-1.5, -11]}
    Y:  {pos: TE, at: [-1, 4.3]}
    LT: {pos: OL, at: [-1, -2.8]}
    LG: {pos: OL, at: [-1, -1.4]}
