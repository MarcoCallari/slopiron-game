     pass_blocking: 32, run_blocking: 41, catch: 75, run_route: 43, break_tackle: 87, hold_onto_ball: 75, pass_accuracy: 25,
     pass_arm_strength: 29, pass_read_coverage: 13, tackle: 9, kick_power: 12, kick_accuracy: 16, stamina: 76, durability: 87,
     leadership: 48, scramble: 16, composure: 36, consistency: 47, aggressiveness: 57, discipline: 69,
     catch_in_traffic: 68, deep_accuracy: 17, reaction: 70, awareness: 54, vision: 78, acceleration: 85, juke: 67,
     longevity: 49}
