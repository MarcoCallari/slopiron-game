     pass_blocking: 16, run_blocking: 25, catch: 23, run_route: 29, break_tackle: 22, hold_onto_ball: 34, pass_accuracy: 74,
     pass_arm_strength: 63, pass_read_coverage: 79, tackle: 31, kick_power: 20, kick_accuracy: 15, stamina: 34, durability: 83,
     leadership: 69, scramble: 70, composure: 65, consistency: 56, aggressiveness: 40, discipline: 84,
     catch_in_traffic: 35, deep_accuracy: 72, reaction: 76, awareness: 73, vision: 72, acceleration: 73, juke: 71,
