# Used for field goals and extra points.
name: Field Goal
unit: field_goal
players:
  LS:  {pos: LS, at: [-0.6, 0],  role: snap}
  LG:  {pos: OL, at: [-1, -1.4], role: pass_block}
  RG:  {pos: OL, at: [-1, 1.4],  role: pass_block}
  LT:  {pos: OL, at: [-1, -2.8], role: pass_block}
  RT:  {pos: OL, at: [-1, 2.8],  role: pass_block}
  LTE: {pos: TE, at: [-1, -4.2], role: pass_block}
  RTE: {pos: TE, at: [-1, 4.2],  role: pass_block}
  LW:  {pos: ST, at: [-1.8, -5.4], role: pass_block}
  RW:  {pos: ST, at: [-1.8, 5.4],  role: pass_block}
  H:   {pos: H,  at: [-7, 0],    role: hold}
  K:   {pos: K,  at: [-9.5, -1.5], role: kick}
name: Field Goal Block
unit: field_goal_block
players:
  B1:  {pos: DE, at: [1, -6.5], role: kick_block}
  B2:  {pos: DT, at: [1, -4.5], role: kick_block}
  B3:  {pos: DT, at: [1, -3],   role: kick_block}
  B4:  {pos: DE, at: [1, -1.5], role: kick_block}
  B5:  {pos: DT, at: [1, 0],    role: kick_block}
  B6:  {pos: DE, at: [1, 1.5],  role: kick_block}
  B7:  {pos: DT, at: [1, 3],    role: kick_block}
  B8:  {pos: LB, at: [1, 4.5],  role: kick_block}
  B9:  {pos: LB, at: [1, 6.5],  role: kick_block}
  S1:  {pos: S,  at: [9, -6],   role: zone}
  S2:  {pos: S,  at: [9, 6],    role: zone}
# The receiving team against a declared onside kick: the hands team. Five sure-handed players at the
# restraining line eleven yards off the ball, four behind them, two deep for a kick over the top.
# They break on the ball once it is kicked (config/simulation.yaml kick_units hands_range).
name: Hands Team
unit: kick_return
players:
  F1:  {pos: WR, at: [11, -18], role: return_block}
  F2:  {pos: TE, at: [11, -9],  role: return_block}
  F3:  {pos: WR, at: [11, 0],   role: return_block}
  F4:  {pos: TE, at: [11, 9],   role: return_block}
  F5:  {pos: WR, at: [11, 18],  role: return_block}
  S1:  {pos: RB, at: [17, -13], role: return_block}
  S2:  {pos: CB, at: [17, -4],  role: return_block}
  S3:  {pos: S,  at: [17, 4],   role: return_block}
  S4:  {pos: CB, at: [17, 13],  role: return_block}
  D1:  {pos: KR, at: [30, -6],  role: return}
  D2:  {pos: KR, at: [30, 6],   role: return}
# Receiving team for the dynamic kickoff: nine blockers in the setup zone (receiving 35 to 30,
# i.e. 30-35 yards from the ball), two returners deep.
name: Kick Return
unit: kick_return
players:
  KR1: {pos: KR, at: [62, -5], role: return}
  KR2: {pos: KR, at: [57, 5],  role: return}
  F1:  {pos: ST, at: [30, -20], role: return_block}
  F2:  {pos: ST, at: [30, -10], role: return_block}
  F3:  {pos: ST, at: [30, 0],   role: return_block}
  F4:  {pos: ST, at: [30, 10],  role: return_block}
  F5:  {pos: ST, at: [30, 20],  role: return_block}
  M1:  {pos: ST, at: [34, -14], role: return_block}
  M2:  {pos: ST, at: [34, -5],  role: return_block}
  M3:  {pos: ST, at: [34, 5],   role: return_block}
  M4:  {pos: ST, at: [34, 14],  role: return_block}
# Special-teams units. Players are listed inline (no formation file).
#   pos: depth-chart group. K, P, LS (long snapper), H (holder), KR, PR (returners),
#        ST (core special-teamers; falls back to LB, S, CB, TE, RB, WR...), or any regular group.
#   at:  [x, y] relative to the ball, x toward the opponent's goal.
# Roles: kick, punt, hold, snap, cover, gunner, return, return_block, jam, kick_block, pass_block, zone
#
# Dynamic kickoff (NFL 2024+): the kicker kicks from his own 35, the coverage lines up at the
# receiving team's 40 (25 yards ahead of the ball) and may not move until the ball is caught or
# lands ("release: catch"). Kicks that land short of the receiving 20 are spotted at the 40.
# For a classic kickoff, put the coverage at x = -1 and use release: kick.
name: Kickoff
unit: kickoff
release: catch
players:
  K:   {pos: K,  at: [-6, 0],     role: kick}
  L5:  {pos: ST, at: [25, -22],   role: cover}
  L4:  {pos: ST, at: [25, -17],   role: cover}
  L3:  {pos: ST, at: [25, -12],   role: cover}
  L2:  {pos: ST, at: [25, -7],    role: cover}
  L1:  {pos: ST, at: [25, -2.5],  role: cover}
  R1:  {pos: ST, at: [25, 2.5],   role: cover}
  R2:  {pos: ST, at: [25, 7],     role: cover}
  R3:  {pos: ST, at: [25, 12],    role: cover}
  R4:  {pos: ST, at: [25, 17],    role: cover}
  R5:  {pos: ST, at: [25, 22],    role: cover}
# Victory formation: the quarterback takes the snap under center and takes a knee, the clock keeps
# running. Two backs stand beside him, a third man stays deep in case of a fumble. Used to run out
# the clock (the "Kneel" button, or the CPU when it can end the half or the game this way).
name: Kneel
type: pass
description: "Victory formation: take a knee, the clock keeps running"
players:
  QB: {pos: QB, at: [-1.3, 0],  role: pass}
  LB: {pos: RB, at: [-2.3, -1.8], role: pass_block}
  RB: {pos: FB, at: [-2.3, 1.8],  role: pass_block}
  SF: {pos: RB, at: [-10, 0],   role: pass_block}
  Y:  {pos: TE, at: [-1, 4.3],  role: pass_block}
  U:  {pos: TE, at: [-1, -4.3], role: pass_block}
  LT: {pos: OL, at: [-1, -2.8], role: pass_block}
  LG: {pos: OL, at: [-1, -1.4], role: pass_block}
  C:  {pos: OL, at: [-0.6, 0],  role: pass_block}
  RG: {pos: OL, at: [-1, 1.4],  role: pass_block}
  RT: {pos: OL, at: [-1, 2.8],  role: pass_block}
ai: {kneel: true}
# A declared onside kick (NFL since 2024: the traditional kickoff formation, no surprise onside kicks).
# The whole unit lines up a yard behind the ball and may not recover it before it has gone ten yards
# (rules.yaml onside). The kicker pops a short bouncer toward one sideline (config/simulation.yaml kicking onside_*).
name: Onside Kick
unit: kickoff
release: kick
onside: true
players:
  K:   {pos: K,  at: [-6, 0],     role: kick}
  L5:  {pos: ST, at: [-1, -22],   role: cover}
  L4:  {pos: ST, at: [-1, -17],   role: cover}
  L3:  {pos: ST, at: [-1, -12],   role: cover}
  L2:  {pos: ST, at: [-1, -7],    role: cover}
  L1:  {pos: ST, at: [-1, -2.5],  role: cover}
  R1:  {pos: ST, at: [-1, 2.5],   role: cover}
  R2:  {pos: ST, at: [-1, 7],     role: cover}
  R3:  {pos: ST, at: [-1, 12],    role: cover}
  R4:  {pos: ST, at: [-1, 17],    role: cover}
  R5:  {pos: ST, at: [-1, 22],    role: cover}
name: Punt
unit: punt
players:
  LS:  {pos: LS, at: [-0.6, 0],  role: snap}
  LG:  {pos: OL, at: [-1, -1.4], role: pass_block}
  RG:  {pos: OL, at: [-1, 1.4],  role: pass_block}
  LT:  {pos: ST, at: [-1, -2.8], role: pass_block}
  RT:  {pos: ST, at: [-1, 2.8],  role: pass_block}
  LW:  {pos: ST, at: [-2, -4.0], role: pass_block}
  RW:  {pos: ST, at: [-2, 4.0],  role: pass_block}
  PP:  {pos: ST, at: [-6, 0],    role: pass_block}
  GL:  {pos: ST, at: [-1, -20],  role: gunner}
  GR:  {pos: ST, at: [-1, 20],   role: gunner}
  P:   {pos: P,  at: [-14, 0],   role: punt}
name: Punt Return
unit: punt_return
players:
  PR:  {pos: PR, at: [42, 0],   role: return}
  JL1: {pos: CB, over: "#1 left",  depth: 1, inside: -0.8, role: jam}
  JL2: {pos: ST, over: "#1 left",  depth: 1.5, inside: 0.8, role: jam}
  JR1: {pos: CB, over: "#1 right", depth: 1, inside: -0.8, role: jam}
  JR2: {pos: ST, over: "#1 right", depth: 1.5, inside: 0.8, role: jam}
  B1:  {pos: ST, at: [1, -5],   role: kick_block}
  B2:  {pos: ST, at: [1, -3],   role: kick_block}
  B3:  {pos: ST, at: [1, -1],   role: kick_block}
  B4:  {pos: ST, at: [1, 1],    role: kick_block}
  B5:  {pos: ST, at: [1, 3],    role: kick_block}
  B6:  {pos: ST, at: [1, 5],    role: kick_block}
# Route library.
# Points are relative to the receiver's alignment:
#   x = yards downfield,  y = yards toward his own sideline (+) or toward the ball (-).
# The same route therefore works from either side of the formation.
# sit: true  -> the receiver settles at the last point (and drifts away from defenders)
# sit: false -> he keeps running in the direction of the last leg
go:          {points: [[3, 0.5], [50, 1]]}
seam:        {points: [[4, -0.5], [50, -1.5]]}
slant:       {points: [[2, 0], [7, -5]]}
hitch_5:     {points: [[6, 0], [5, 0.3]], sit: true}
hitch_6:     {points: [[7, 0], [6, 0.3]], sit: true}
hitch_7:     {points: [[8, 0], [7, 0.3]], sit: true}
stick_6:     {points: [[6, 0], [6, -1.5]], sit: true}
comeback_12: {points: [[14, 0], [12, 2.5]], sit: true}
out_6:       {points: [[6, 0], [6.5, 14]], sit: true}
out_10:      {points: [[10, 0], [10.5, 14]], sit: true}
corner:      {points: [[10, 0], [24, 10]]}
post:        {points: [[12, 0], [32, -11]]}
dig_10:      {points: [[10, 0], [10, -20]]}
dig_12:      {points: [[12, 0], [12, -22]]}
dig_14:      {points: [[14, 0], [14, -20]]}
drag_4:      {points: [[1.5, -1.5], [4, -8], [4, -30]]}
drag_6:      {points: [[1.5, -1.5], [6, -8], [6, -30]]}
flat:        {points: [[1.5, 3], [3, 9]], sit: true}
wheel:       {points: [[1.5, 4], [5, 9], [40, 10]]}
checkdown:   {points: [[1.5, 2.5], [4, 3]], sit: true}

# added for the bigger playbook
curl_10:     {points: [[11, 0], [10, -1]], sit: true}
out_15:      {points: [[15, 0], [15.5, 14]], sit: true}
fade:        {points: [[3, 1.5], [40, 6]]}
sluggo:      {points: [[2, 0], [5, -2.5], [45, 0]]}
arrow:       {points: [[3, 6]], sit: true}
bubble:      {points: [[-1, 2], [-0.5, 6]], sit: true}
whip:        {points: [[4, -2], [4, 4]], sit: true}
angle:       {points: [[1.5, 3], [5, -3]], sit: true}
swing:       {points: [[-1, 3], [0, 9]], sit: true}
deep_cross:  {points: [[8, 0], [18, -22], [20, -32]]}
seam_post:   {points: [[12, -0.5], [30, -6]]}
block_stay:  {points: [[0.5, 0], [1, 0]], sit: true}
# gadget routes
reverse_back: {points: [[-2.5, -9], [-3.5, -24]]}
throwback:   {points: [[-6, -2]], sit: true}
qb_flat:     {points: [[2, 6], [7, 9]], sit: true}
qb_wheel:    {points: [[2, 7], [8, 11], [30, 13]]}

# screens and the end of the half
screen_rb:     {points: [[2, 3.5], [2.5, 6.5]], sit: true}     # back: slide out behind the line once the rush is past
tunnel:        {points: [[-1, -1.5], [-0.5, -6.5]], sit: true} # wide receiver: step back and come inside behind the wall
hail_outside:  {points: [[8, -1], [70, -12]]}                  # Hail Mary: everybody to the same spot in the end zone
hail_inside:   {points: [[8, 0], [70, -5]]}
out_12:        {points: [[12, 0], [12.5, 14]], sit: true}
comeback_15:   {points: [[17, 0], [15, 2.5]], sit: true}

# quick game, shot plays and screens (the bigger playbook, second round)
quick_out:     {points: [[4, 0], [4.5, 9]], sit: true}         # speed out at 4-5 yards
hitch_4:       {points: [[5, 0], [4, 0.3]], sit: true}
shallow:       {points: [[1.5, -1.5], [3, -8], [3, -30]]}      # shallow cross just past the line
snag:          {points: [[5, 0], [5, -3]], sit: true}          # sit down in the spot between the zones
quick_in:      {points: [[5, 0], [5.5, -10]], sit: true}
dig_8:         {points: [[8, 0], [8, -20]]}
curl_8:        {points: [[9, 0], [8, -1]], sit: true}
cross_8:       {points: [[2, -1], [8, -14], [9, -30]]}
corner_6:      {points: [[6, 0], [16, 8]]}                     # short corner (smash, flat-7)
post_corner:   {points: [[10, 0], [14, -3], [26, 10]]}
out_and_up:    {points: [[5, 0], [5.5, 3], [7, 4], [40, 5]]}
skinny_post:   {points: [[10, 0], [35, -5]]}
te_screen:     {points: [[0.5, 1], [0, 4]], sit: true}         # tight end: release, turn around behind the wall
now_screen:    {points: [[-0.5, -1]], sit: true}               # outside receiver: one step back, ball now
swing_wide:    {points: [[-1, 4], [0, 12]], sit: true}
# Game rules. All yard lines are measured from the team's own goal line (0..100).
game:
  quarter_minutes: 15         # default quarter length (the team-select screen offers 3 to 15)
  default_matchup: [CAR, PIT] # home, away: preselected on the team-select screen, default of the text tools
  kickoff_spot: 35            # kicking team kicks from its own 35
  kickoff_touchback: 35       # receiving team's ball after a kickoff touchback (2025 NFL rule)
  kickoff_out_of_bounds: 40   # receiving team's ball after a kickoff goes out of bounds
  kickoff_landing_zone: 20    # a kickoff nobody fields that comes down short of the receiving team's 20 counts as out of bounds (2024 rule)
  punt_touchback: 20
  turnover_touchback: 20      # interception / fumble downed in the end zone
  free_kick_spot: 20          # free kick after a safety
  extra_point_spot: 15        # line of scrimmage for the PAT kick (a 33-yard kick)
  two_point_spot: 2           # line of scrimmage for a two-point try
  # The game clock follows NFL rules (see README "Clock"). How long the teams take between plays
  # depends on the tempo (huddle, no huddle, running the play clock down) and on the play clock:
  timeouts_per_half: 3
  play_clock: 40              # seconds from the end of a play to the snap
  play_clock_after_stoppage: 25   # after timeouts, penalties, changes of possession, the two-minute warning
  two_minute_warning: true
  # Overtime (NFL rules since 2025): a coin toss, a kickoff, and both teams get the ball once (unless the
  # kicking team scores a safety). After that whoever is ahead wins; still tied: the next score wins.
  # A regular-season game can end in a tie, a playoff game goes on until somebody wins. The lengths are
  # for 15-minute quarters (a game with 5-minute quarters plays a third as long).
  overtime: true
  overtime_minutes: 10
  playoff_overtime_minutes: 15
  overtime_timeouts: 2
  preseason_overtime: false   # a tied preseason game ends in a tie (NFL since 2021)
  overtime_quarter_minutes: 15  # the overtime lengths above are for quarters this long
  # Downs, spots and the clock rules the game enforces between plays.
  first_down_yards: 10        # yards to gain for a new set of downs
  missed_field_goal_spot: 20  # a missed field goal: the other team's ball at the spot of the kick, at least at its own 20
  two_minute_seconds: 120     # the two-minute warning; also: out of bounds stops the clock from here on in the 2nd quarter ...
  out_of_bounds_minutes: 5    # ... and in the last this many minutes of the 4th
  runoff_seconds: 10          # an offensive foul that stops a running clock in the last two minutes of a half costs this much

# Onside kicks. Since the 2024 dynamic kickoff an onside kick must be declared: the kicking team lines up
# in the traditional formation, the receiving team brings its hands team (no surprise onside kicks).
# 2024: only a team trailing in the 4th quarter; 2025: a trailing team at any time; 2026: any team, any time.
onside:
  allowed: true
  fourth_quarter_only: false
  trailing_only: false
  min_distance: 10            # the kicking team may recover it only once it has gone ten yards

# Points.
scoring:
  touchdown: 6
  field_goal: 3
  safety: 2
  extra_point: 1
  two_point: 2
  defense_try: 2                     # the defense returns a try (a blocked kick, a turnover) to the other end zone

# Penalty yards (half the distance to the goal line when that is shorter). The game enforces them; the
# fouls called during a play (by the on-field simulation) carry the yards of their kind.
penalties:
  pre_snap: 5                        # false start, offside
  return_foul: 10                    # holding / illegal block by the return team: from the spot of the foul (or the end of the return)
  roughing_kicker: 15                # the kicking team keeps the ball
  defensive_holding: 5               # plays: defensive holding (automatic first down)
  holding: 10                        # offensive holding
  offensive_pass_interference: 10
  illegal_block: 10                  # illegal block in the back (kick returns)
  roughing: 15                       # roughing the passer / the kicker
  face_mask: 15
  unnecessary_roughness: 15          # a late hit out of bounds
  intentional_grounding: 10          # from the line, or from the passer's spot when that is farther back; and loss of down
  tackle_box: 4                      # a passer this far (yards) to either side of the ball has left the tackle box: he may throw it away past the line

# ---- Career mode: the NFL's league rules ----
# The league year: the regular season, then the playoffs (one week per round: wild card, divisional,
# conference championships, Super Bowl), free agency, the draft, the preseason.
season:
  regular_weeks: 18                  # weeks 1-18 (17 games and a bye); the playoff rounds are weeks 19-22
  playoff_teams: 7                   # per conference: the four division winners (seeds 1-4), then the wild cards
  bye_teams: [2, 2, 4, 4, 4, 4, 4, 4, 2, 2]   # how many teams have their bye in each week from first_bye_week on
  first_bye_week: 5                  # (the byes are in weeks 5-14)
  spare_bye_week: 9                  # the bye of teams beyond those of bye_teams (a league of another size)
  common_games_min: 4                # wild-card tiebreaker: the record against common opponents counts from this many games
  trade_deadline: 9                  # trades end after this week (they open again with free agency)
  free_agency_weeks: 3               # free agency's weeks (the teams sign players), then the draft
  preseason_weeks: 3                 # after the draft: the preseason games (they count for nothing), then the cuts to the roster limit

# Roster sizes.
roster:
  limit: 53                          # players on a roster during the season (injured reserve does not count)
  offseason_limit: 90                # after the Super Bowl until the final cuts after the preseason (the 90-man camp roster)

# Injured reserve: a player on it does not count against the roster limit.
injured_reserve:
  min_games: 4                       # he misses at least this many games (and goes on it only when out that long)
  returns: 8                         # players a team can bring back from it per season (the others stay there)

# The salary cap. Money is in thousands of dollars (301200 = $301.2M), in base_season's money: the cap,
# the minimum salaries and the rookie scale grow with the cap every season.
salary_cap:
  base_season: 2026                  # the season the money figures are for
  cap: 301200                        # the cap of the base season ($301.2M)
  growth: 1.065                      # the cap and every money figure grow this much a season
  minimum_salary: [885, 1005, 1075, 1145, 1215, 1215, 1215, 1300]   # by credited seasons: a rookie, one season ... seven and more
  contract_years_max: 5              # a contract runs one to this many years
  bonus_proration_years: 5           # a signing bonus counts against the cap spread over the contract's years, at most this many
  offseason_top_contracts: 51        # off-season (until the final cuts): only this many of a team's highest cap hits count (the "top 51" rule)

# Rookie contracts: the wage scale by overall pick (straight lines between the points, the last
# point's for picks after it), first-rounders fully guaranteed with a fifth-year option.
rookie_contracts:
  scale_total: [[1, 57270], [2, 54675], [5, 47831], [10, 30958], [16, 22341], [32, 16784], [33, 10800], [64, 6900],
                [65, 6400], [100, 5900], [101, 5100], [140, 4800], [180, 4500], [224, 4180], [260, 4150]]   # the contract's total
  scale_bonus: [[1, 38111], [2, 36223], [5, 31246], [10, 18975], [16, 12708], [32, 8686], [33, 4700], [64, 1600],
                [65, 1500], [100, 1000], [101, 900], [140, 500], [180, 300], [224, 110], [260, 90]]          # its signing bonus
  guaranteed_seasons: [[32, 4], [48, 2], [64, 1]]   # up to this pick: this many seasons of base salary guaranteed (later: none)
  years: 4                           # a drafted rookie's contract
  option_picks: 32                   # the picks whose contracts have a fifth-year option (the first round)
  undrafted_years: 3                 # an undrafted rookie's contract, at the minimum salary

# Draft picks.
draft:
  rounds: 7                          # every team has one pick per round (in the draft order)
  tradeable_years: 3                 # the picks of this many coming drafts can be traded

# Jersey numbers by position group (NFL rules): a player who joins a team gets the first free number of
# the first range of his group, then of the next range (none free: any free number 0-99).
jersey_numbers:
  QB: [[1, 19]]
  RB: [[20, 39], [0, 9]]
  FB: [[40, 49], [30, 39]]
  WR: [[10, 19], [80, 89], [0, 9]]
  TE: [[80, 89], [40, 49]]
  OL: [[60, 79], [50, 59]]
  DE: [[90, 99], [50, 59], [40, 49]]
  DT: [[90, 99], [60, 79]]
  LB: [[40, 59], [0, 9]]
  CB: [[20, 39], [0, 9]]
  S: [[20, 49], [0, 9]]
  K: [[1, 19], [90, 99]]
  P: [[1, 19], [90, 99]]
  LS: [[40, 69]]
